# ---- Pappers Immobilier ----
# Clé API (https://immobilier.pappers.fr/api). Laisser vide => mode "mock" (fixtures).
PAPPERS_API_KEY=
PAPPERS_BASE_URL=https://api-immobilier.pappers.fr/v1

# ---- Base de données ----
# SQLite par défaut (zéro config). Pour Postgres :
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/immobilier
DATABASE_URL=sqlite:///./immobilier.db

# ---- Scheduler (recherches fréquentes) ----
SCHEDULER_ENABLED=true
# Intervalle (secondes) entre deux passages du scheduler qui déclenche les recherches dues.
SCHEDULER_TICK_SECONDS=300

# ---- Maîtrise des crédits Pappers ----
# Bases incluses par défaut dans une recherche (séparées par des virgules).
# "ventes" = 2 crédits/parcelle mais indispensable pour afficher prix/surface.
DEFAULT_BASES=ventes
# Plafond d'appels Pappers par exécution (garde-fou anti-conso).
MAX_PAGES_PER_RUN=5
# Durée de vie du cache des réponses Pappers (secondes).
CACHE_TTL_SECONDS=3600

# ---- Scraping ----
# Proxy (http(s)://user:pass@host:port) pour les sites protégés (Leboncoin, SeLoger...).
PROXY_URL=
# Délai mini entre deux requêtes d'une même source (anti-blocage).
SCRAPER_RATE_LIMIT_MS=2000

# ---- Couche headless (récolte de cookies Datadome : Leboncoin, SeLoger) ----
# Sur le poste de dev (IP résidentielle), un navigateur persistant récolte le cookie
# Datadome (captcha résolu une fois à la main), puis les connecteurs API le réutilisent.
#   pip install -r requirements-scrapers.txt && playwright install chromium
#   python scripts/refresh_datadome.py leboncoin   # ouvre un Chromium visible
HEADLESS_STATE_DIR=.headless          # profils Chromium + cache cookie (gitignored)
HEADLESS_HEADED=false                 # true : navigateur visible (1er solve / refresh)
DATADOME_MAX_AGE_MINUTES=60           # fraîcheur du cookie récolté
# Cookie Datadome collé à la main (alternative à la récolte ; UA mobile par défaut).
#   python scripts/refresh_datadome.py leboncoin   |   python scripts/refresh_datadome.py seloger
LEBONCOIN_DATADOME=
SELOGER_DATADOME=

# ---- Source "agences" (newsletters email + sites) ----
# Clé API Claude pour l'extraction LLM des annonces (sinon repli heuristique).
ANTHROPIC_API_KEY=
EXTRACT_MODEL=claude-haiku-4-5
AGENCES_CONFIG_PATH=agences.yaml
AGENCES_INGEST_INTERVAL_MINUTES=30
# Boîte mail dédiée où sont reçues les newsletters d'agences (IMAP).
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_USE_SSL=true

# ---- Enrichissement (Lot A) ----
# Enrichir automatiquement chaque recherche (sinon via ?enrich=true ou /listings/{id}/enrich).
ENRICH_ON_SEARCH=false
# Temps de trajet train (Navitia) : clé gratuite sur navitia.io. Vide => critère 'pending'.
NAVITIA_API_KEY=
NAVITIA_ORIGIN=Paris
# (GPU zonage, Géorisques, altitude IGN : open data, aucune clé requise.)

# ---- Divers ----
HTTP_TIMEOUT_SECONDS=20
# Origines autorisées pour le futur front (CORS), séparées par des virgules.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
